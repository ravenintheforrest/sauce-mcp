# Sauce MCP server — copy to .env for local `npm run dev`. See ../docs/CONTRACT.md.
SUPABASE_URL=http://ravelab.local:8000
SUPABASE_SERVICE_KEY=replace-with-service-role-key
# Owner to stamp on MCP-created rows so they're visible to RLS-scoped clients (ADR-0006).
# = the auth.users id of the single user / household owner.
SAUCE_OWNER_ID=replace-with-user-uuid

# --- HTTP / cloud connector (dist/http.js) ---
PORT=8788
SAUCE_MCP_TOKEN=replace-with-a-long-random-secret   # required to protect the hosted endpoint
SAUCE_PUBLIC_BASE=https://sauce-api.ravenhoward.org  # base baked into stored image URLs

# --- Auto-image (optional) ---
# If set, new recipes get a clean Unsplash photo by title; otherwise Wikipedia fallback.
UNSPLASH_ACCESS_KEY=optional-unsplash-access-key
